  "candidate_invariants": [
    "Every SUPPORTS edge cites a distinct, actually selected evidence ID.",
    "A provisional hypothesis requires at least two distinct selected supports.",
    "Any valid contradiction forces HUMAN_REVIEW regardless of remaining clean hypotheses.",
    "A hypothesis citing either contradiction endpoint is withdrawn; clean hypotheses remain visible only.",
    "Contradiction edges remain traceable even when no hypothesis is active.",
    "Duplicate, reversed-duplicate, self, unknown-endpoint, and duplicate-ID inputs reject rather than normalize.",
    "Permuting evidence order preserves state and edge sets.",
    "Malformed non-string IDs reject with ValueError and produce no partial graph."
  ],
  "priority_fixes": [
    {
      "id": "p1",
      "fix": "Add strict type checks for evidence, hypothesis, and supporting IDs before any coercion or lookup.",
      "tests": [
        "t10",
        "t11",
        "t16"
      ]
    },
    {
      "id": "p2",
